<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ближайшая пара" android:textSize="11sp" android:textStyle="bold" android:textColor="#254CCE" />
        <TextView android:id="@+id/widget_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:textColor="#182333" />
        <TextView android:id="@+id/widget_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textColor="#254CCE" />
    </LinearLayout>
    <ImageView android:id="@+id/widget_map" android:layout_width="64dp" android:layout_height="52dp" android:layout_marginStart="5dp" android:scaleType="centerCrop" android:contentDescription="Кабинет и соседние помещения" />
</LinearLayout>
